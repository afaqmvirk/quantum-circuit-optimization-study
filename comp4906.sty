\setlength{\parindent}{0pt}
\setlength{\parskip}{3pt}
\setcounter{secnumdepth}{0}
\titleformat{\section}{\normalfont\normalsize\bfseries}{}{0pt}{}
\titleformat{\subsection}{\normalfont\normalsize\bfseries}{}{0pt}{}
\titlespacing*{\section}{0pt}{7pt}{2pt}
\titlespacing*{\subsection}{0pt}{5pt}{2pt}
\setlist{leftmargin=1.25em,itemsep=0pt,topsep=3pt,parsep=0pt}
\setlength{\LTpre}{4pt}
\setlength{\LTpost}{4pt}
\setlength{\LTleft}{0pt}
\setlength{\LTright}{\fill}
\raggedbottom
\pagestyle{plain}
\clubpenalty=8000
\widowpenalty=8000
\emergencystretch=1em

\newcommand{\thesisauthor}{Afaq Virk}
\newcommand{\thesisheader}[2]{%
  \hypersetup{pdftitle={#1},pdfauthor={\thesisauthor},pdfsubject={#2}}%
  \begin{flushright}
    {\Large\bfseries\setlength{\baselineskip}{17.25pt}#1\par}
    \vspace{1pt}
    {\setlength{\baselineskip}{13.5pt}%
     \thesisauthor\\
     Carleton University, School of Computer Science\\
     COMP 4906 -- #2\\
     Dr.\ Sriram Subramanian \&\\
     Dr.\ Michel Barbeau\\
     24 November 2026\par}
  \end{flushright}%
  \vspace{-6pt}%
}

\newcommand{\researchquestion}[1]{%
  \begin{quote}
    \bfseries #1
  \end{quote}%
}

\let\comphonours@bibliography\thebibliography
\renewcommand{\thebibliography}[1]{%
  \comphonours@bibliography{#1}%
  \fontsize{9}{11}\selectfont
  \setlength{\itemsep}{0pt}%
  \setlength{\parsep}{0pt}%
}

\newcommand{\thesisreferences}{%
  \clearpage
  \bibliographystyle{ieeetr}%
  \bibliography{references}%
}
