\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{comp4906}[2026/11/24 COMP 4906 thesis layout]

\RequirePackage[letterpaper,margin=1in]{geometry}
\RequirePackage[T1]{fontenc}
